# Free key from Google AI Studio (aistudio.google.com). Never paste it in chat or commit it.
GEMINI_API_KEY=
# Model names. Run `python -m rxproto models` to see what your key can use.
RX_MODEL_FAST=gemini-flash-latest
RX_MODEL_STRONG=gemini-pro-latest
# Seconds between calls (free tier has a requests-per-minute limit)
RX_MIN_SECONDS=6.5
# Hard stop on the number of model calls in one run
RX_MAX_CALLS=800
# Optional: USD per 1M tokens, copied from Google's pricing page, to turn token counts into dollars
RX_PRICE_IN_FAST=
RX_PRICE_OUT_FAST=
RX_PRICE_IN_STRONG=
RX_PRICE_OUT_STRONG=
# Optional: run through Vertex AI instead of an AI Studio key (same models, same code)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: run the same Gemini models through OpenRouter (prepaid). If set, it is used instead of GEMINI_API_KEY.
OPENROUTER_API_KEY=

# Stop a run once it has spent this many US dollars (0 = no cap)
RX_MAX_USD=10
